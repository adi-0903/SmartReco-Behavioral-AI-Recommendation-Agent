# =============================================================================
# SmartReco - Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# =============================================================================

# Flask Configuration
SECRET_KEY=your-super-secret-key-min-32-chars
FLASK_ENV=development
DEBUG=true
PORT=5000

# Database
DATABASE_URL=sqlite:///smartreco.db

# Mesh API Configuration (Mandatory for LLM/AI calls via Mesh Gateway)
# Get your key from https://meshapi.ai
MESH_API_KEY=rsk_your_mesh_api_key_here
MESH_BASE_URL=https://api.meshapi.ai/v1
MESH_MODEL=openai/gpt-4o

# NVIDIA NIM LLM Configuration (High-Performance Endpoint Fallback)
# Get your key from https://build.nvidia.com
NVIDIA_API_KEY=nvapi_your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Email Configuration (Gmail SMTP for OTP delivery)
# Create an App Password at https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Admin Credentials (CHANGE THESE IN PRODUCTION!)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-secure-admin-password

# Redis Configuration (for caching, rate limiting, sessions)
REDIS_URL=redis://localhost:6379/0
RATELIMIT_STORAGE_URL=redis://localhost:6379/1

# Rate Limiting
RATELIMIT_DEFAULT=200 per minute

# Optional: LangSmith Tracing & Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=SmartReco-Behavioral-Agent

# Scheduler Settings
SCHEDULER_INTERVAL_MINUTES=60